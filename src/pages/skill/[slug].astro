---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodePlayground from '../../components/react/CodePlayground.tsx';
import ThemeToggle from '../../components/react/ThemeToggle.tsx';
import { getCollection, render } from 'astro:content';
import type { SupportedLanguage } from '../../lib/languages';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map((skill) => ({
    params: { slug: skill.id },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);

const languages: SupportedLanguage[] = ['go', 'java', 'typescript', 'python'];
const starterCode = Object.fromEntries(
  languages.map((lang) => [lang, skill.data.starterCode[lang] ?? '']),
) as Record<SupportedLanguage, string>;
---

<BaseLayout title={skill.data.title}>
  <main class="flex h-screen flex-col">
    <header class="flex items-center justify-between gap-4 border-b border-zinc-200 px-6 py-3 dark:border-zinc-800">
      <div class="flex items-center gap-4">
        <a href="/" class="text-sm text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200">← Roadmap</a>
        <h1 class="text-lg font-bold">{skill.data.title}</h1>
        <span class="rounded bg-zinc-100 px-2 py-0.5 text-xs uppercase tracking-wide text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
          {skill.data.category}
        </span>
      </div>
      <ThemeToggle client:load />
    </header>
    <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
      <article class="prose prose-zinc max-w-none min-h-0 overflow-y-auto px-8 py-6 dark:prose-invert lg:w-1/2">
        <Content />
      </article>
      <section class="min-h-0 flex-1 border-t border-zinc-200 lg:w-1/2 lg:flex-none lg:border-l lg:border-t-0 dark:border-zinc-800">
        <CodePlayground client:load skillId={skill.id} starterCode={starterCode} />
      </section>
    </div>
  </main>
</BaseLayout>
