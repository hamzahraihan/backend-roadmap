---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodePlayground from '../../components/react/CodePlayground.tsx';
import SimulationStage from '../../components/react/SimulationStage.tsx';
import GitSimulation from '../../components/react/GitSimulation.tsx';
import SplitShell from '../../components/SplitShell.astro';
import TopBar from '../../components/TopBar.astro';
import { getCollection, render } from 'astro:content';
import type { SupportedLanguage } from '../../lib/languages';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map((skill) => ({
    params: { slug: skill.id },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const { Content } = await render(skill);

const languages: SupportedLanguage[] = ['go', 'java', 'typescript', 'python'];
const starterCode = Object.fromEntries(
  languages.map((lang) => [lang, skill.data.starterCode[lang] ?? '']),
) as Record<SupportedLanguage, string>;

const isGitSimulation = skill.data.simulation === 'git' || ['version-control','git-fundamentals','git-branching','git-remotes','github-workflow','cicd'].includes(skill.id);
const isDesignSimulation = skill.data.simulation === 'design';
---

<BaseLayout title={skill.data.title}>
  <main class="flex h-screen flex-col">
    <TopBar variant="skill" title={skill.data.title} category={skill.data.category} />
    <div class="flex min-h-0 flex-1">
      <SplitShell storageKey="backend-roadmap:split:skill" defaultPct={50} minPct={25} maxPct={75}>
        <article slot="left" class="prose prose-zinc max-w-none min-h-0 h-full overflow-y-auto px-8 py-6 dark:prose-invert">
          <Content />
        </article>
        <section slot="right" class="flex min-h-0 h-full flex-col border-t border-zinc-200 dark:border-zinc-800 lg:border-l lg:border-t-0">
          {isGitSimulation ? <GitSimulation client:load skillId={skill.id} /> : isDesignSimulation ? <SimulationStage client:load skillId={skill.id} layout="panel" /> : <CodePlayground client:load skillId={skill.id} starterCode={starterCode} />}
        </section>
      </SplitShell>
    </div>
  </main>
</BaseLayout>
