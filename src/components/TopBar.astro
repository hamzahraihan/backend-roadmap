---
import ThemeToggle from './react/ThemeToggle.tsx';
import LanguageToggle from './react/LanguageToggle.tsx';
import ActivitiesSidebar from './react/ActivitiesSidebar.tsx';
import { ChevronDownIcon, ChevronUpIcon, CommitIcon, EyeNoneIcon, EyeOpenIcon, HomeIcon, LayersIcon, ListBulletIcon } from '@radix-ui/react-icons';
import { getCollection } from 'astro:content';

interface Props {
  variant?: 'home' | 'skill' | 'playground' | 'design' | 'guide';
  title?: string;
  category?: string;
}

const { variant = 'home', title, category } = Astro.props;

const isHome = variant === 'home';
const isSkill = variant === 'skill';
const isPlayground = variant === 'playground';
const isDesign = variant === 'design';
const isGuide = variant === 'guide';

const dockItem = (active: boolean) =>
  `flex items-center gap-1.5 rounded-xl px-2.5 py-2 text-xs font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 ${
    active
      ? 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900'
      : 'text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800'
  }`;

const allSkills = (await getCollection('skills'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({
    id: s.id,
    title: s.data.title,
    category: s.data.category,
    order: s.data.order,
    dependsOn: s.data.dependsOn,
  }));
---

<nav
  data-topbar
  aria-label="Primary"
  class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] left-1/2 z-40 w-max max-w-[calc(100vw-2rem)] -translate-x-1/2 select-none transition-transform duration-300 ease-out"
>
  <div class="flex items-center gap-1 overflow-x-auto rounded-2xl border border-zinc-200/80 bg-white/80 px-2 py-1.5 text-zinc-900 shadow-2xl backdrop-blur-xl dark:border-zinc-700/80 dark:bg-zinc-900/80 dark:text-zinc-100">
    <button
      type="button"
      data-activities-trigger
      aria-expanded="false"
      aria-controls="activities-drawer"
      aria-haspopup="dialog"
      aria-label="Open activities"
      data-i18n-aria="openActivities"
      class="flex items-center gap-2 rounded-xl px-2.5 py-2 text-zinc-600 hover:bg-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:text-zinc-300 dark:hover:bg-zinc-800"
    >
      <span class="grid h-[18px] w-[18px] shrink-0 grid-cols-3 gap-0.5" aria-hidden="true">
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
        <span class="h-[5px] w-[5px] rounded-[1.5px] bg-current"></span>
      </span>
      <span class="hidden text-xs font-semibold tracking-tight sm:inline" data-i18n="activities">Activities</span>
    </button>

    <span class="h-5 w-px shrink-0 bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>

    <a href="/" aria-current={isHome ? 'page' : undefined} class={dockItem(isHome)}>
      <HomeIcon width={15} height={15} />
      <span class="hidden sm:inline" data-i18n="roadmap">Roadmap</span>
    </a>
    <a href="/guide" aria-current={isGuide ? 'page' : undefined} class={dockItem(isGuide)}>
      <ListBulletIcon width={15} height={15} />
      <span class="hidden sm:inline" data-i18n="guide">Guide</span>
    </a>
    <a href="/playground" aria-current={isPlayground ? 'page' : undefined} class={dockItem(isPlayground)}>
      <CommitIcon width={15} height={15} />
      <span class="hidden sm:inline" data-i18n="playground">Playground</span>
    </a>
    <a href="/design" aria-current={isDesign ? 'page' : undefined} class={dockItem(isDesign)}>
      <LayersIcon width={15} height={15} />
      <span class="hidden sm:inline" data-i18n="designStudio">Design Studio</span>
    </a>

    <span class="h-5 w-px shrink-0 bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>

    <span class="flex shrink-0 items-center gap-1.5">
      <LanguageToggle client:load compact />
      <ThemeToggle client:load compact />
    </span>
    <span class="h-5 w-px shrink-0 bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></span>

    <button
      type="button"
      data-dock-toggle
      aria-expanded="true"
      aria-label="Hide navigation"
      title="Hide navigation"
      class="flex shrink-0 items-center rounded-xl px-2 py-2 text-zinc-500 hover:bg-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:text-zinc-400 dark:hover:bg-zinc-800"
    >
      <ChevronDownIcon width={15} height={15} />
    </button>
  </div>
</nav>

<button
  type="button"
  data-dock-tab
  aria-label="Show navigation"
  title="Show navigation"
  class="fixed bottom-[max(0.5rem,env(safe-area-inset-bottom))] left-1/2 z-40 hidden -translate-x-1/2 items-center rounded-full border border-zinc-200/80 bg-white/80 px-3 py-1.5 text-zinc-500 shadow-xl backdrop-blur-xl hover:text-zinc-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-zinc-700/80 dark:bg-zinc-900/80 dark:text-zinc-400 dark:hover:text-zinc-100"
>
  <ChevronUpIcon width={15} height={15} />
</button>

{isSkill && (
  <div data-topchip class="fixed left-4 top-4 z-40 flex min-w-0 max-w-[calc(100vw-2rem)] items-center gap-2 rounded-xl border border-zinc-200/80 bg-white/80 px-3 py-2 text-sm shadow-lg backdrop-blur-xl transition-transform duration-300 ease-out dark:border-zinc-700/80 dark:bg-zinc-900/80">
    <a href="/" class="flex shrink-0 items-center gap-1.5 font-semibold text-zinc-900 hover:text-sky-600 dark:text-zinc-100 dark:hover:text-sky-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded">
      <svg width="18" height="18" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0"><rect x="2" y="2" width="60" height="60" rx="14" fill="#ffffff"/><rect x="2" y="2" width="60" height="60" rx="14" fill="none" stroke="#e4e4e7" stroke-width="2"/><rect x="17" y="14" width="8.5" height="36" rx="2" fill="#800020"/><path d="M29 14h7.5a18 18 0 0 1 0 36H29v-8.5h6.5a9.75 9.75 0 0 0 0-19H29z" fill="#800020"/></svg>
      <span><span style="color: #800020;">D</span>issect</span>
    </a>
    {title && (
      <>
        <span class="shrink-0 text-zinc-400 dark:text-zinc-600" aria-hidden="true">›</span>
        <span class="truncate font-medium text-zinc-600 dark:text-zinc-300">{title}</span>
      </>
    )}
    {category && (
      <span class="hidden shrink-0 rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium uppercase tracking-wide text-zinc-500 sm:inline dark:bg-zinc-800 dark:text-zinc-400">
        {category}
      </span>
    )}
    <button
      data-docs-toggle
      aria-pressed="false"
      aria-label="Hide documentation"
      class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-600 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
      title="Hide/show documentation"
    >
      <span data-docs-icon-open><EyeOpenIcon width={14} height={14} /></span>
      <span data-docs-icon-closed class="hidden"><EyeNoneIcon width={14} height={14} /></span>
      <span data-docs-toggle-label>Hide docs</span>
    </button>
    <button
      type="button"
      data-topchip-toggle
      aria-expanded="true"
      aria-label="Hide navigation"
      title="Hide navigation"
      class="inline-flex shrink-0 items-center rounded-full px-1.5 py-1.5 text-zinc-500 hover:bg-zinc-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:text-zinc-400 dark:hover:bg-zinc-800"
    >
      <ChevronUpIcon width={14} height={14} />
    </button>
  </div>
)}

{isSkill && (
  <button
    type="button"
    data-topchip-tab
    aria-label="Show navigation"
    title="Show navigation"
    class="fixed left-4 top-2 z-40 hidden items-center rounded-full border border-zinc-200/80 bg-white/80 px-2.5 py-1 text-zinc-500 shadow-lg backdrop-blur-xl hover:text-zinc-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-zinc-700/80 dark:bg-zinc-900/80 dark:text-zinc-400 dark:hover:text-zinc-100"
  >
    <ChevronDownIcon width={14} height={14} />
  </button>
)}

<ActivitiesSidebar client:load skills={allSkills} />

<script>
  import { getUILocale, subscribeUILocale, t, type UIStringKey } from '../lib/i18n';

  // Re-render Astro-rendered (static) TopBar strings when the UI locale
  // changes. React islands re-render via useUILocale() themselves.
  function renderTopBarLocale() {
    const locale = getUILocale();
    document.querySelectorAll('[data-topbar] [data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n') as UIStringKey | null;
      if (key) el.textContent = t(locale, key);
    });
    document.querySelectorAll('[data-topbar] [data-i18n-aria]').forEach((el) => {
      const key = el.getAttribute('data-i18n-aria') as UIStringKey | null;
      if (key) el.setAttribute('aria-label', t(locale, key));
    });
    // Docs toggle label depends on collapsed state (aria-pressed).
    const docsBtn = document.querySelector('[data-docs-toggle]');
    const label = docsBtn?.querySelector('[data-docs-toggle-label]');
    if (docsBtn && label) {
      const collapsed = docsBtn.getAttribute('aria-pressed') === 'true';
      label.textContent = t(locale, collapsed ? 'showDocs' : 'hideDocs');
      const docLabel = t(locale, collapsed ? 'showDocumentation' : 'hideDocumentation');
      docsBtn.setAttribute('aria-label', docLabel);
      docsBtn.setAttribute('title', docLabel);
    }
    // Dock chevron always hides, edge tab always shows: static roles, localized labels.
    const dockToggle = document.querySelector('[data-dock-toggle]');
    if (dockToggle) {
      const hideLabel = t(locale, 'collapseNav');
      dockToggle.setAttribute('aria-label', hideLabel);
      dockToggle.setAttribute('title', hideLabel);
    }
    const dockTab = document.querySelector('[data-dock-tab]');
    if (dockTab) {
      const showLabel = t(locale, 'expandNav');
      dockTab.setAttribute('aria-label', showLabel);
      dockTab.setAttribute('title', showLabel);
    }
    const topchipToggle = document.querySelector('[data-topchip-toggle]');
    if (topchipToggle) {
      const hideLabel = t(locale, 'collapseNav');
      topchipToggle.setAttribute('aria-label', hideLabel);
      topchipToggle.setAttribute('title', hideLabel);
    }
    const topchipTab = document.querySelector('[data-topchip-tab]');
    if (topchipTab) {
      const showLabel = t(locale, 'expandNav');
      topchipTab.setAttribute('aria-label', showLabel);
      topchipTab.setAttribute('title', showLabel);
    }
  }

  renderTopBarLocale();
  subscribeUILocale(renderTopBarLocale);
  window.addEventListener('docs-toggle', renderTopBarLocale);
  window.addEventListener('docs-collapsed-sync', renderTopBarLocale);
  window.addEventListener('dock-toggle', renderTopBarLocale);
</script>

<script is:inline>
  (function () {
    const docsBtn = document.querySelector('[data-docs-toggle]');
    const activitiesTriggers = document.querySelectorAll('[data-activities-trigger]');

    // Docs toggle (existing)
    if (docsBtn) {
      const label = docsBtn.querySelector('[data-docs-toggle-label]');
      const collapsedKey = 'backend-roadmap:split:skill:collapsed';
      function setDocsBtn(collapsed) {
        docsBtn.setAttribute('aria-pressed', String(collapsed));
        docsBtn.setAttribute('aria-label', collapsed ? 'Show documentation' : 'Hide documentation');
        docsBtn.title = collapsed ? 'Show documentation' : 'Hide documentation';
        if (label) label.textContent = collapsed ? 'Show docs' : 'Hide docs';
        docsBtn.querySelectorAll('[data-docs-icon-open]').forEach((el) => el.classList.toggle('hidden', collapsed));
        docsBtn.querySelectorAll('[data-docs-icon-closed]').forEach((el) => el.classList.toggle('hidden', !collapsed));
      }
      try {
        const raw = localStorage.getItem(collapsedKey);
        if (raw != null) {
          const c = JSON.parse(raw);
          if (typeof c === 'boolean') setDocsBtn(c);
        }
      } catch {}
      window.addEventListener('docs-collapsed-sync', function (e) {
        const c = e.detail && typeof e.detail.collapsed === 'boolean' ? e.detail.collapsed : false;
        setDocsBtn(c);
      });
      docsBtn.addEventListener('click', function () {
        const collapsed = docsBtn.getAttribute('aria-pressed') === 'true';
        const next = !collapsed;
        setDocsBtn(next);
        try { localStorage.setItem(collapsedKey, JSON.stringify(next)); } catch {}
        window.dispatchEvent(new CustomEvent('docs-toggle', { detail: { collapsed: next } }));
      });
    }

    // Activities toggle
    function dispatchActivitiesToggle() {
      const isOpen = document.querySelector('[data-activities-drawer]')?.getAttribute('aria-hidden') === 'false';
      // The sidebar listens for activities:toggle and flips if no detail
      window.dispatchEvent(new CustomEvent('activities:toggle'));
      // also sync aria-expanded on triggers
      const nextOpen = !isOpen;
      activitiesTriggers.forEach((el) => el.setAttribute('aria-expanded', String(nextOpen)));
    }

    activitiesTriggers.forEach((btn) => {
      btn.addEventListener('click', dispatchActivitiesToggle);
    });

    // Keep aria-expanded in sync when sidebar closes via Escape/backdrop
    window.addEventListener('activities:open', () => {
      activitiesTriggers.forEach((el) => el.setAttribute('aria-expanded', 'true'));
    });
    window.addEventListener('activities:close', () => {
      activitiesTriggers.forEach((el) => el.setAttribute('aria-expanded', 'false'));
    });
    window.addEventListener('activities:toggle', (e) => {
      const detail = e.detail || {};
      let next;
      if (typeof detail.open === 'boolean') next = detail.open;
      else {
        const current = document.querySelector('[data-activities-drawer]')?.getAttribute('aria-hidden') === 'false';
        next = !current;
      }
      activitiesTriggers.forEach((el) => el.setAttribute('aria-expanded', String(next)));
    });

    // Dock: swipe/click to park at the edge, tab to restore. Persisted.
    const dock = document.querySelector('[data-topbar]');
    const dockToggle = document.querySelector('[data-dock-toggle]');
    const dockTab = document.querySelector('[data-dock-tab]');
    const dockKey = 'backend-roadmap:dock-collapsed';
    if (dock && dockToggle && dockTab) {
      function setDock(collapsed) {
        dock.classList.toggle('translate-y-[calc(100%+2rem)]', collapsed);
        dockToggle.setAttribute('aria-expanded', String(!collapsed));
        dockTab.classList.toggle('hidden', !collapsed);
        dockTab.classList.toggle('flex', collapsed);
        try { localStorage.setItem(dockKey, collapsed ? '1' : '0'); } catch {}
        window.dispatchEvent(new CustomEvent('dock-toggle', { detail: { collapsed } }));
      }
      try {
        if (localStorage.getItem(dockKey) === '1') setDock(true);
      } catch {}
      dockToggle.addEventListener('click', () => setDock(true));
      dockTab.addEventListener('click', () => setDock(false));
      // Swipe down (or sideways) on the dock parks it; small taps ignored.
      let sx = 0, sy = 0;
      dock.addEventListener('touchstart', (e) => {
        const touch = e.changedTouches[0];
        sx = touch.clientX; sy = touch.clientY;
      }, { passive: true });
      dock.addEventListener('touchend', (e) => {
        const touch = e.changedTouches[0];
        const dx = touch.clientX - sx, dy = touch.clientY - sy;
        if (dy > 48 || Math.abs(dx) > 72) setDock(true);
      }, { passive: true });
    }

    // Skill context chip: same park-at-edge treatment (upward).
    const topchip = document.querySelector('[data-topchip]');
    const topchipToggle = document.querySelector('[data-topchip-toggle]');
    const topchipTab = document.querySelector('[data-topchip-tab]');
    const topchipKey = 'backend-roadmap:topchip-collapsed';
    if (topchip && topchipToggle && topchipTab) {
      function setTopchip(collapsed) {
        topchip.classList.toggle('translate-y-[calc(-100%-2rem)]', collapsed);
        topchipToggle.setAttribute('aria-expanded', String(!collapsed));
        topchipTab.classList.toggle('hidden', !collapsed);
        topchipTab.classList.toggle('flex', collapsed);
        try { localStorage.setItem(topchipKey, collapsed ? '1' : '0'); } catch {}
        window.dispatchEvent(new CustomEvent('dock-toggle', { detail: { collapsed } }));
      }
      try {
        if (localStorage.getItem(topchipKey) === '1') setTopchip(true);
      } catch {}
      topchipToggle.addEventListener('click', () => setTopchip(true));
      topchipTab.addEventListener('click', () => setTopchip(false));
      // Swipe up on the chip parks it; small taps ignored.
      let tx = 0, ty = 0;
      topchip.addEventListener('touchstart', (e) => {
        const touch = e.changedTouches[0];
        tx = touch.clientX; ty = touch.clientY;
      }, { passive: true });
      topchip.addEventListener('touchend', (e) => {
        const touch = e.changedTouches[0];
        const dx = touch.clientX - tx, dy = touch.clientY - ty;
        if (dy < -48 || Math.abs(dx) > 72) setTopchip(true);
      }, { passive: true });
    }
  })();
</script>

<style>
  [data-topbar] {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>
